# Copy to .dev.vars for LOCAL development only. Never commit actual values.
APP_ORIGIN="http://localhost:8787"
GOOGLE_CLIENT_ID="replace-with-public-web-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="replace-with-server-only-client-secret"
# Generate a random 32-byte key with: openssl rand -base64 32
SESSION_ENCRYPTION_KEY="replace-with-base64-encoded-32-byte-key"
ALLOWED_EMAILS="you@example.com"
